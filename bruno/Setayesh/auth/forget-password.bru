meta {
  name: forget-password
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/forgot-password
  body: json
  auth: inherit
}

body:json {
  {
      "email":"user@example.org"
  }
}

script:post-response {
  var jsonData = res.getBody();
  if (res.getStatus() == 200){
      bru.setVar("AUTH_TOKEN", jsonData.data.token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
