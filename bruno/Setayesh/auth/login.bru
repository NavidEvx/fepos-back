meta {
  name: login
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
      "email":"admin@example.com",
      "password":"password",
      "remember_me":1
  }
}

script:post-response {
  var jsonData = res.getBody();
  if (res.getStatus() == 200){
      bru.setVar("AUTH_TOKEN", jsonData.data.token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
